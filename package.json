{
  "name": "@zotoio/botz-mcp-swarm-cli",
  "version": "0.11.2",
  "description": "MCP Swarm extension for botz: botz mcp-swarm [args]",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "botz-mcp-swarm": "./dist/cli.js",
    "swarm": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsdown --config-loader native",
    "lint": "tsc --noEmit",
    "test": "vitest run && node --test scripts/release-policy-check.mjs",
    "check:leakage": "node scripts/check-leakage.mjs",
    "check:cli-pack": "node scripts/check-cli-pack.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [
    "mcp",
    "load-test",
    "model-context-protocol",
    "ci",
    "botz"
  ],
  "author": "zotoio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zotoio/botz-mcp-swarm-cli.git"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.40",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "commander": "^15.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsdown": "^0.23.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.1"
  },
  "homepage": "https://github.com/zotoio/botz-mcp-swarm-cli#readme",
  "bugs": {
    "url": "https://github.com/zotoio/botz-mcp-swarm-cli/issues"
  },
  "packageManager": "pnpm@10.34.6"
}
